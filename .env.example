# مفتاح Groq API (المزوّد الأساسي المجاني للبحث وملفات اللاعبين والمساعد)
GROQ_API_KEY=

# موديل Groq الأساسي (اختياري، الافتراضي openai/gpt-oss-120b والاحتياطي openai/gpt-oss-20b)
GROQ_MODEL=

# مفتاح واجهة برمجة تطبيقات Gemini (مزوّد احتياطي)
GEMINI_API_KEY=

# قائمة موديلات Gemini بالترتيب حسب الأولوية وتفصل بينها فاصلة (اختياري)
GEMINI_MODELS="gemini-3.1-flash-lite,gemini-3.8-flash"

# منفذ تشغيل الخادم المحلي
PORT=3000
